Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Floor (sim_world z=0)
      Enabled: true
      Reference Frame: sim_world
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Ground truth (MuJoCo)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /ground_truth/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      TF Prefix: ground_truth
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: sim_world
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point: {X: 0, Y: 0, Z: 0.6}
      Target Frame: <Fixed Frame>
      Pitch: 0.35
      Yaw: 0.8
