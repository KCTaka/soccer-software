<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>humanoid_transport_stm32</name>
  <version>0.1.0</version>
  <description>
    Stm32SerialTransport: the production ActuatorTransport (ADR-001-04). Speaks the master-link
    protocol of soccer-firmware over USB CDC to the master STM32, which schedules the 200 Hz SPI
    exchange to the slave STM32s and the CAN bus to the RobStride drives.
  </description>
  <maintainer email="unassigned@example.invalid">Robotics Software Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>humanoid_transport</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
