# ── Developer image (blueprint §12) ──
# Full toolchain: ROS 2 Jazzy desktop + build tools + Python ML deps + sim camera.
# Used on the workstation and in CI; NOT shipped to robots.
FROM ros:jazzy-ros-base

SHELL ["/bin/bash", "-c"]

COPY deploy/docker/soccer-app-deps.apt /tmp/deps.apt
RUN apt-get update \
    && grep -v '^\s*#' /tmp/deps.apt | tr -d '\r' | xargs apt-get install -y --no-install-recommends \
    && apt-get install -y --no-install-recommends build-essential cmake git \
    && rm -rf /var/lib/apt/lists/* /tmp/deps.apt

RUN pip3 install --no-cache-dir --break-system-packages \
    ruff

WORKDIR /ws
CMD ["bash"]
