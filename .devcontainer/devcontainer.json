{
  "name": "RoboSoccer Dev Container",
  "build": {
    "dockerfile": "../docker/builder.Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind",

  "runArgs": ["--ipc=host", "--net=host"],

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY::0}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY:wayland-0}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR:/mnt/wslg/runtime-dir}",
    "PULSE_SERVER": "${localEnv:PULSE_SERVER:unix:/mnt/wslg/PulseServer}",
    "QT_X11_NO_MITSHM": "1"
  },

    "mounts": [
      "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
      "source=/mnt/wslg,target=/mnt/wslg,type=bind"
    ],

  "postCreateCommand": "echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc && echo '[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash' >> ~/.bashrc",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.autopep8",
        "ms-iot.vscode-ros",

        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
